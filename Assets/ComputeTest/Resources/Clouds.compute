#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Assets/Core/BlueNoise.hlsl"

// Render clouds
#pragma kernel RenderClouds

// Input textures
TEXTURE2D_X(_DepthTexture);
TEXTURE2D_X(_VolumetricCloudsSourceDepth);
TEXTURE2D_X(_MaxZMaskTexture);

TEXTURE3D(_VolumeTexture);
SAMPLER(sampler_VolumeTexture);

// History buffers
TEXTURE2D_X(_HistoryVolumetricClouds0Texture);
TEXTURE2D_X(_HistoryVolumetricClouds1Texture);

// Output texture
RWTexture2D<float> _DepthBufferRW;
RWTexture2D<float> _CloudsDepthTextureRW;
RWTexture2D<float4> _CloudsLightingTextureRW;;

CBUFFER_START(ShaderVariableClouds)
float4 _TraceScreenSize;
float4 _FinalScreenSize;
float4 _VolumeTexture_TexelSize;
float4x4 _CloudsPixelCoordToViewDirWS;
CBUFFER_END

///////////
// Utils //
///////////

