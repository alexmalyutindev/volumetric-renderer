//     return saturate(hClip.z / hClip.w);
// }

/////////

float SampleVolume(float3 position)
{
    // position = saturate(position);
    float dist = length(position);

    const half4 sample = SAMPLE_TEXTURE3D_LOD(_VolumeTexture, sampler_VolumeTexture, position * 0.1, 0);
    float result = saturate(dot(sample.rgb, _LayerWeights.rgb));
    return result * max(0, 1 - dist * 0.5);
}

