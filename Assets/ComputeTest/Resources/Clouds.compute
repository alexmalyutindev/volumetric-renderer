float3 ComputePositionWS()
{
    return 0;
}

[numthreads(8, 8, 1)]
void RenderClouds(uint3 traceCoord : SV_DispatchThreadID, uint2 groupThreadId : SV_GroupThreadID, uint2 groupId : SV_GroupID)
{
    int _RaySteps = 20.0;
    int _ShadowSteps = 10.0;
    float _Density = 5.0;
    float _ShadowDensity = 5.0;
    float traceDist = 5.0;
    float _ShadowThreshold = 0.01;

    // If this is bigger than the trace size, we are done
    if (any(traceCoord.xy >= uint2(_TraceScreenSize.xy)))
        return;

    float2 screenUV = traceCoord.xy * _TraceScreenSize.zw;
    float2 positionCS = traceCoord.xy * _TraceScreenSize.zw * 2.0 - 1.0;
    float3 rayOrigin = float3(positionCS, 0);
    float3 rayDirection = float3(positionCS, 1);
    
    rayOrigin = _WorldSpaceCameraPos;

    rayDirection = mul(_CloudsPixelCoordToViewDirWS, float4(rayDirection, 1)).xyz;
    rayDirection = rayDirection / _RaySteps * traceDist;

    half jitter = SAMPLE_BLUENOISE(screenUV, 0.5);
    rayOrigin += rayDirection * jitter;
    
    half density = _Density / _RaySteps * traceDist;

    half shadowStepSize = 1.0 / _ShadowSteps;
    half shadowDensity = _ShadowDensity * shadowStepSize;
    float shadowThresh = -log(_ShadowThreshold) / shadowDensity;
    float3 lightDir = _MainLightPosition.xyz * shadowStepSize;

    half currentDensity = 0.0;
    half transmittance = 1.0;
    half lightEnergy = 0.0;
    
    int currentIndex = 0;
    while (currentIndex < _RaySteps)
    {
        float sample = SampleVolume(rayOrigin);

        //Sample Light Absorption and Scattering
        if (sample > 0.001)
        {
            float3 lightRay = rayOrigin; // + lightDir * jitter;
            half shadowDist = 0;

            int lightIndex = 0;
            while (lightIndex < _ShadowSteps)
            {
                lightRay += lightDir;
                half lightSample = SampleVolume(lightRay);
                
                half3 shadowBoxTest = floor(abs(lightRay - 0.5) + 0.5);
                half exitShadowBox = shadowBoxTest.x + shadowBoxTest.y + shadowBoxTest.z;

                shadowDist += lightSample;
                if (shadowDist > shadowThresh || exitShadowBox >= 1.0)
                    break;

                lightIndex++;
            }

            currentDensity = saturate(sample * density);
            half shadowTerm = exp(-shadowDist * shadowDensity);
            half absorbedLight = shadowTerm * currentDensity;
            lightEnergy += absorbedLight * transmittance;
            transmittance *= 1.0 - currentDensity;
        }

        if (transmittance < 0.01)
        {
            transmittance = 0;
            break;
        }

        rayOrigin += rayDirection;
        currentIndex++;
    }

    float3 light = lerp(float3(0.17, 0.38, 0.52), _MainLightColor.rgb, lightEnergy);
    _CloudsLightingTextureRW[traceCoord.xy] = float4(light, 1 - transmittance);
}
